---
import {
  headingClassNames,
  statblockSectionClassNames,
  type StatblockFeatureLevel,
  type StatblockSectionProps,
  type StatblockSectionTitleLevel,
} from '@eevenkoto/core';
import StatblockFeature from './StatblockFeature.astro';

export interface Props extends StatblockSectionProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  title,
  titleLevel = 2,
  bodyHtml,
  features,
  class: classProp,
  className,
  ...rest
} = Astro.props;

const classes = [statblockSectionClassNames(), classProp, className].filter(Boolean).join(' ');
const tagLevel: StatblockSectionTitleLevel =
  titleLevel === 4 ? 4 : titleLevel === 3 ? 3 : 2;
const TitleTag = tagLevel === 4 ? 'h4' : tagLevel === 3 ? 'h3' : 'h2';
const defaultFeatureLevel = (tagLevel + 1) as StatblockFeatureLevel;
---
<section class={classes} {...rest}>
  <TitleTag class={headingClassNames({ level: 2 })}>{title}</TitleTag>
  {bodyHtml ? <Fragment set:html={bodyHtml} /> : null}
  {features?.map((feature) => (
    <StatblockFeature
      name={feature.name}
      description={feature.description}
      descriptionHtml={feature.descriptionHtml}
      level={feature.level ?? defaultFeatureLevel}
    />
  ))}
  <slot />
</section>
