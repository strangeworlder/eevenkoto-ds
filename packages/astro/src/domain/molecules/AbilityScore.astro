---
import { abilityScoreClassNames, type AbilityScoreProps } from '@eevenkoto/core';
import { slugifyId } from '@eevenkoto/html';
import Stat from '../../core/atoms/Stat.astro';

export interface Props extends AbilityScoreProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  label,
  labelId: labelIdProp,
  score,
  modifier,
  save,
  scoreLabel = 'Score',
  modifierLabel = 'Modifier',
  saveLabel = 'Save',
  saveProficient = false,
  proficientLabel = 'proficient',
  class: classProp,
  className,
  ...rest
} = Astro.props;

const labelId = labelIdProp ?? `eevenkoto-ability-${slugifyId(label)}`;
const classes = [abilityScoreClassNames({ saveProficient }), classProp, className]
  .filter(Boolean)
  .join(' ');
const saveTerm = saveProficient ? `${saveLabel} (${proficientLabel})` : saveLabel;
---
<figure class={classes} {...rest}>
  <figcaption id={labelId} class="eevenkoto-ability-score__label">{label}</figcaption>
  <dl class="eevenkoto-ability-score__stats" aria-labelledby={labelId}>
    <div class="eevenkoto-ability-score__stat eevenkoto-ability-score__stat--modifier">
      <dt class="eevenkoto-ability-score__stat-label">{modifierLabel}</dt>
      <dd class="eevenkoto-ability-score__stat-value">
        <Stat value={modifier} shape="arch" size="lg" />
      </dd>
    </div>
    <div class="eevenkoto-ability-score__stat eevenkoto-ability-score__stat--score">
      <dt class="eevenkoto-ability-score__stat-label">{scoreLabel}</dt>
      <dd class="eevenkoto-ability-score__stat-value">
        <Stat value={score} shape="disk" size="sm" />
      </dd>
    </div>
    <div class="eevenkoto-ability-score__stat eevenkoto-ability-score__stat--save">
      <dt class="eevenkoto-ability-score__stat-label">{saveTerm}</dt>
      <dd class="eevenkoto-ability-score__stat-value">
        <Stat value={save} shape="shield" size="sm" emphasis={saveProficient} />
      </dd>
    </div>
  </dl>
</figure>
