---
import {
  checkboxBadgeClassNames,
  checkboxClassNames,
  checkboxContentClassNames,
  checkboxControlClassNames,
  checkboxDescriptionClassNames,
  checkboxTitleClassNames,
  type CheckboxProps,
} from '@eevenkoto/core';
import Badge from './Badge.astro';

export interface Props extends CheckboxProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  id,
  name,
  value,
  label,
  description,
  badge,
  checked,
  defaultChecked,
  disabled,
  variant,
  card,
  invalid,
  size,
  ariaLabel,
  ariaDescribedBy,
  class: classProp,
  className,
  ...rest
} = Astro.props;

const classes = [
  checkboxClassNames({ variant, card, size, invalid, disabled }),
  classProp,
  className,
]
  .filter(Boolean)
  .join(' ');
const isChecked = checked ?? defaultChecked;
const hasBadgeSlot = Astro.slots.has('badge');
---
<label class={classes}>
  <input
    type="checkbox"
    id={id}
    name={name}
    value={value}
    checked={isChecked || undefined}
    disabled={disabled || undefined}
    aria-invalid={invalid ? 'true' : undefined}
    aria-label={ariaLabel}
    aria-describedby={ariaDescribedBy}
    class={checkboxControlClassNames()}
    {...rest}
  />
  <span class={checkboxContentClassNames()}>
    <strong class={checkboxTitleClassNames()}>{label}<slot /></strong>
    {description ? <span class={checkboxDescriptionClassNames()}>{description}</span> : null}
  </span>
  {hasBadgeSlot ? (
    <span class={checkboxBadgeClassNames()}><slot name="badge" /></span>
  ) : badge ? (
    <span class={checkboxBadgeClassNames()}><Badge label={badge} size="sm" /></span>
  ) : null}
</label>
