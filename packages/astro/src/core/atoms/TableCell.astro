---
import {
  tableCellClassNames,
  type TableCellKind,
  type TableCellProps,
  type TableCellScope,
  type TableElementAttributes,
} from '@eevenkoto/core';

export interface Props extends TableCellProps {
  kind?: TableCellKind;
  scope?: TableCellScope;
  tabIndex?: number;
  tabindex?: number;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  kind = 'text',
  text,
  html,
  header = false,
  scope,
  colSpan,
  rowSpan,
  angled = false,
  inTable = false,
  tabIndex,
  tabindex,
  attributes,
  class: classProp,
  className,
  ...rest
} = Astro.props;

const SAFE_ATTR_NAME_RE = /^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/;
const extraAttrs: Record<string, string | number | boolean> = {};
if (attributes) {
  for (const [name, value] of Object.entries(attributes)) {
    if (value === undefined || value === false || name === 'class') continue;
    if (!SAFE_ATTR_NAME_RE.test(name) || /^on/i.test(name)) continue;
    extraAttrs[name] = value === true && name.startsWith('data-') ? '' : value;
  }
}

const attrClass = typeof attributes?.class === 'string' ? attributes.class.trim() : '';
const classes =
  [tableCellClassNames({ kind, inTable }), classProp, className, attrClass]
    .filter(Boolean)
    .join(' ') || undefined;
const Tag = header ? 'th' : 'td';
const wrapHeadLabel = angled && header && kind === 'numeric';
const hasDefaultSlot = Astro.slots.has('default');
const resolvedTabIndex = tabIndex ?? tabindex;
---
<Tag
  class={classes}
  scope={scope}
  colspan={colSpan}
  rowspan={rowSpan}
  tabindex={resolvedTabIndex}
  {...extraAttrs}
  {...rest}
>{hasDefaultSlot ? (wrapHeadLabel ? <span class="eevenkoto-table-cell__head-label"><slot /></span> : <slot />) : html !== undefined ? (wrapHeadLabel ? <span class="eevenkoto-table-cell__head-label" set:html={html} /> : <Fragment set:html={html} />) : (wrapHeadLabel ? <span class="eevenkoto-table-cell__head-label">{text ?? ''}</span> : (text ?? ''))}</Tag>
