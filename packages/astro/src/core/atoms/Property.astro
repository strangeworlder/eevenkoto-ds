---
import { propertyClassNames, type PropertyProps } from '@eevenkoto/core';

export interface Props extends PropertyProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const { label, value, valueHtml, class: classProp, className, ...rest } = Astro.props;
const classes = [propertyClassNames(), classProp, className].filter(Boolean).join(' ');
const hasDefaultSlot = Astro.slots.has('default');
---
<div class={classes} {...rest}>
  <dt class="eevenkoto-property__label">{label}</dt>
  {hasDefaultSlot ? (
    <dd class="eevenkoto-property__value"><slot /></dd>
  ) : valueHtml !== undefined ? (
    <dd class="eevenkoto-property__value" set:html={valueHtml} />
  ) : (
    <dd class="eevenkoto-property__value">{value ?? ''}</dd>
  )}
</div>
