---
import {
  propertyClassNames,
  propertyMetaClassNames,
  type PropertyProps,
} from '@eevenkoto/core';

export interface Props extends PropertyProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const { label, value, valueHtml, meta, class: classProp, className, ...rest } = Astro.props;
const classes = [propertyClassNames(), classProp, className].filter(Boolean).join(' ');
const hasDefaultSlot = Astro.slots.has('default');
const metaClass = propertyMetaClassNames();
const metaLines = (Array.isArray(meta) ? meta : meta ? [meta] : []).filter(Boolean);
---
<div class={classes} {...rest}>
  <dt class="eevenkoto-property__label">{label}</dt>
  {hasDefaultSlot ? (
    <dd class="eevenkoto-property__value">
      <slot />
      {metaLines.map((line) => <span class={metaClass}>{line}</span>)}
    </dd>
  ) : valueHtml !== undefined ? (
    metaLines.length > 0 ? (
      <dd class="eevenkoto-property__value">
        <Fragment set:html={valueHtml} />
        {metaLines.map((line) => <span class={metaClass}>{line}</span>)}
      </dd>
    ) : (
      <dd class="eevenkoto-property__value" set:html={valueHtml} />
    )
  ) : (
    <dd class="eevenkoto-property__value">{value ?? ''}{metaLines.map((line) => <span class={metaClass}>{line}</span>)}</dd>
  )}
</div>
