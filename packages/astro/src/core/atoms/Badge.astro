---
import { badgeClassNames, type BadgeProps } from '@eevenkoto/core';

export interface Props extends Omit<BadgeProps, 'label'> {
  label?: string;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const { label, variant, size, shape, intent, dot, class: classProp, className, ...rest } = Astro.props;
const classes = [badgeClassNames({ variant, size, shape, intent }), classProp, className]
  .filter(Boolean)
  .join(' ');
---
<span class={classes} {...rest}>{dot ? <span class="eevenkoto-badge__dot" aria-hidden="true"></span> : null}<span class="eevenkoto-badge__label">{label}<slot /></span></span>
