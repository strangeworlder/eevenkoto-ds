---
import { chipClassNames, type ChipProps } from '@eevenkoto/core';
import Icon from './Icon.astro';
import Swatch from './Swatch.astro';

export interface Props extends Omit<ChipProps, 'label'> {
  label?: string;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  label,
  selected,
  size,
  icon,
  swatchColor,
  href,
  disabled,
  class: classProp,
  className,
  ...rest
} = Astro.props;
const classes = [chipClassNames({ selected, size }), classProp, className].filter(Boolean).join(' ');
const hasLeading = Boolean(swatchColor || icon);
---
{href ? (
  <a
    class={classes}
    href={disabled ? undefined : href}
    aria-disabled={disabled ? 'true' : undefined}
    aria-pressed={selected ? 'true' : undefined}
    {...rest}
  >{hasLeading ? (
    <>
      {swatchColor ? <Swatch color={swatchColor} size="sm" /> : null}
      {icon ? <Icon name={icon} size="sm" /> : null}
      <span class="eevenkoto-chip__label">{label}<slot /></span>
    </>
  ) : (
    <>{label}<slot /></>
  )}</a>
) : (
  <button
    type="button"
    class={classes}
    disabled={disabled || undefined}
    aria-pressed={selected ? 'true' : undefined}
    {...rest}
  >{hasLeading ? (
    <>
      {swatchColor ? <Swatch color={swatchColor} size="sm" /> : null}
      {icon ? <Icon name={icon} size="sm" /> : null}
      <span class="eevenkoto-chip__label">{label}<slot /></span>
    </>
  ) : (
    <>{label}<slot /></>
  )}</button>
)}
