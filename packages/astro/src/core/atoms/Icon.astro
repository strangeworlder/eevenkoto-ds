---
import { iconClassNames, iconPaths, type IconProps } from '@eevenkoto/core';

export interface Props extends IconProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const { name, size, label, class: classProp, className, ...rest } = Astro.props;
const classes = [iconClassNames({ size }), classProp, className].filter(Boolean).join(' ');
---
<svg
  class={classes}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  fill="currentColor"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
><path d={iconPaths[name]} /></svg>
