---
import {
  chipGroupActionClassNames,
  chipGroupClassNames,
  chipGroupHeaderClassNames,
  chipGroupLegendClassNames,
  chipGroupListClassNames,
  type ChipGroupProps,
} from '@eevenkoto/core';
import Chip from '../atoms/Chip.astro';

export interface Props extends ChipGroupProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  id,
  label,
  hideLegend,
  mode = 'single',
  size = 'sm',
  hidden,
  options,
  class: classProp,
  className,
  ...rest
} = Astro.props;
const classes = [chipGroupClassNames(), classProp, className].filter(Boolean).join(' ');
const hasHeaderActionSlot = Astro.slots.has('headerAction');
const labelId = id ? `${id}-label` : undefined;
---
{hasHeaderActionSlot ? (
  <div
    id={id}
    hidden={hidden || undefined}
    class={classes}
    role="group"
    aria-labelledby={labelId}
    aria-label={labelId ? undefined : label}
    data-selection-mode={mode}
    {...rest}
  >
    <div class={chipGroupHeaderClassNames()}>
      <span id={labelId} class={chipGroupLegendClassNames(hideLegend)}>{label}</span>
      <div class={chipGroupActionClassNames()}><slot name="headerAction" /></div>
    </div>
    <div class={chipGroupListClassNames()}>
      {options.map((opt) => (
        <Chip
          label={opt.label}
          selected={mode === 'action' ? false : opt.selected}
          disabled={opt.disabled}
          size={size}
          icon={opt.icon}
          swatchColor={opt.swatchColor}
          href={opt.href}
          data-value={opt.value}
          title={opt.title}
          {...(opt.attributes ?? {})}
        />
      ))}
    </div>
  </div>
) : (
  <fieldset id={id} hidden={hidden || undefined} class={classes} data-selection-mode={mode} {...rest}>
    <legend class={chipGroupLegendClassNames(hideLegend)}>{label}</legend>
    <div class={chipGroupListClassNames()}>
      {options.map((opt) => (
        <Chip
          label={opt.label}
          selected={mode === 'action' ? false : opt.selected}
          disabled={opt.disabled}
          size={size}
          icon={opt.icon}
          swatchColor={opt.swatchColor}
          href={opt.href}
          data-value={opt.value}
          title={opt.title}
          {...(opt.attributes ?? {})}
        />
      ))}
    </div>
  </fieldset>
)}
