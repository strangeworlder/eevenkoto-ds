---
import {
  menuIconClassNames,
  menuItemClassNames,
  menuItemLabelClassNames,
  type MenuAttributes,
  type MenuEntry,
} from '@eevenkoto/core';
import Icon from '../atoms/Icon.astro';
import StatusDot from '../atoms/StatusDot.astro';

export interface Props {
  entries: MenuEntry[];
}

const { entries } = Astro.props;

const SAFE_ATTR_NAME_RE = /^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/;

const normalizeAttributes = (
  attrs?: MenuAttributes,
  omitClass = false,
): Record<string, string | boolean> => {
  const out: Record<string, string | boolean> = {};
  if (!attrs) return out;
  for (const [name, value] of Object.entries(attrs)) {
    if (value === undefined || value === false) continue;
    if (omitClass && name === 'class') continue;
    if (!SAFE_ATTR_NAME_RE.test(name) || /^on/i.test(name)) continue;
    out[name] = value === true && name.startsWith('data-') ? '' : value;
  }
  return out;
};

const mergeClass = (base: string, attrs?: MenuAttributes): string => {
  const extra = typeof attrs?.class === 'string' ? attrs.class.trim() : '';
  return extra ? `${base} ${extra}` : base;
};
---
<ul>
  {entries.map((entry) => {
    if (entry.kind === 'separator') {
      return (
        <li>
          <hr {...normalizeAttributes(entry.attributes)} />
        </li>
      );
    }

    if (entry.kind === 'header') {
      return (
        <li>
          <p
            class={mergeClass('eevenkoto-menu__header', entry.attributes)}
            {...normalizeAttributes(entry.attributes, true)}
          >
            {entry.label}
          </p>
        </li>
      );
    }

    if (entry.kind === 'group') {
      return (
        <li>
          <details open={entry.expanded || undefined} {...normalizeAttributes(entry.attributes)}>
            <summary>
              {entry.icon ? (
                <>
                  <span class={menuIconClassNames()}>
                    <Icon name={entry.icon} />
                  </span>
                  <span class={menuItemLabelClassNames()}>{entry.label}</span>
                </>
              ) : (
                entry.label
              )}
            </summary>
            <Astro.self entries={entry.children} />
          </details>
        </li>
      );
    }

    const itemClasses = mergeClass(
      menuItemClassNames({ selected: entry.selected, locked: entry.locked, tone: entry.tone }),
      entry.attributes,
    );
    const extras = Boolean(entry.icon || entry.locked || entry.status);
    const lockedNoHref = Boolean(entry.locked && !entry.href);

    if (entry.href) {
      const linkInactive = Boolean(entry.disabled || lockedNoHref);
      return (
        <li>
          <a
            {...normalizeAttributes(entry.attributes, true)}
            class={itemClasses}
            href={entry.href}
            aria-current={entry.selected ? 'page' : undefined}
            aria-disabled={linkInactive ? 'true' : undefined}
            tabindex={linkInactive ? -1 : undefined}
          >
            {entry.icon ? (
              <span class={menuIconClassNames()}>
                <Icon name={entry.icon} />
              </span>
            ) : null}
            {extras ? <span class={menuItemLabelClassNames()}>{entry.label}</span> : entry.label}
            {entry.locked ? (
              <span class="eevenkoto-menu__lock">
                <Icon name="lock" />
                <span class="eevenkoto-visually-hidden">{entry.lockedLabel ?? 'Locked'}</span>
              </span>
            ) : null}
            {entry.status ? (
              <span class="eevenkoto-menu__status">
                <StatusDot intent={entry.status} label={entry.statusLabel ?? 'Ready'} />
              </span>
            ) : null}
          </a>
        </li>
      );
    }

    return (
      <li>
        <button
          {...normalizeAttributes(entry.attributes, true)}
          type="button"
          class={itemClasses}
          disabled={entry.disabled || entry.locked || undefined}
        >
          {entry.icon ? (
            <span class={menuIconClassNames()}>
              <Icon name={entry.icon} />
            </span>
          ) : null}
          {extras ? <span class={menuItemLabelClassNames()}>{entry.label}</span> : entry.label}
          {entry.locked ? (
            <span class="eevenkoto-menu__lock">
              <Icon name="lock" />
              <span class="eevenkoto-visually-hidden">{entry.lockedLabel ?? 'Locked'}</span>
            </span>
          ) : null}
          {entry.status ? (
            <span class="eevenkoto-menu__status">
              <StatusDot intent={entry.status} label={entry.statusLabel ?? 'Ready'} />
            </span>
          ) : null}
        </button>
      </li>
    );
  })}
</ul>
