---
import { listClassNames, type ListItemProps, type ListProps } from '@eevenkoto/core';
import ListItem from '../atoms/ListItem.astro';

export interface Props extends Omit<Partial<ListProps>, 'items'> {
  items?: Array<string | ListItemProps>;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const { items = [], variant, size, tone, class: classProp, className, ...rest } = Astro.props;
const classes = [listClassNames({ variant, size, tone }), classProp, className]
  .filter(Boolean)
  .join(' ');
const Tag = (variant ?? 'unordered') === 'ordered' ? 'ol' : 'ul';
const normalizedItems: ListItemProps[] = items.map((item) =>
  typeof item === 'string' ? { text: item } : item,
);
---
<Tag class={classes} {...rest}>
  {normalizedItems.map((item) => (
    <ListItem
      text={item.text}
      html={item.html}
      status={variant === 'checklist' ? (item.status ?? 'included') : item.status}
    />
  ))}
  <slot />
</Tag>
