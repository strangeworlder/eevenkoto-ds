---
import {
  fieldClassNames,
  fieldControlClassNames,
  fieldControlGroupClassNames,
  fieldLabelClassNames,
  fieldMessageClassNames,
  resolveFieldMessageId,
  type FieldProps,
} from '@eevenkoto/core';

export interface Props extends FieldProps {
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  label,
  htmlFor,
  orientation,
  hint,
  error,
  messageId,
  class: classProp,
  className,
  ...rest
} = Astro.props;
const classes = [fieldClassNames({ orientation }), classProp, className].filter(Boolean).join(' ');
const resolvedMessageId = resolveFieldMessageId({ htmlFor, messageId });
const hasError = Boolean(error);
const messageText = hasError ? error : hint;
const hasActionSlot = Astro.slots.has('action');
---
<div class={classes} {...rest}>
  <label class={fieldLabelClassNames()} for={htmlFor}>{label}</label>
  <div class={fieldControlClassNames()}>{hasActionSlot ? (
    <div class={fieldControlGroupClassNames()}><slot /><slot name="action" /></div>
  ) : (
    <slot />
  )}</div>
  {messageText && resolvedMessageId ? (
    <p class={fieldMessageClassNames(hasError)} id={resolvedMessageId}>{messageText}</p>
  ) : null}
</div>
