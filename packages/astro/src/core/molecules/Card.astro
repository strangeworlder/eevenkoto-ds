---
import {
  cardClassNames,
  cardEyebrowClassNames,
  cardHeaderActionsClassNames,
  cardHeaderGroupClassNames,
  type CardProps,
  type CardTitleLevel,
} from '@eevenkoto/core';

export interface Props extends CardProps {
  href?: string;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  surface,
  featured,
  current,
  layout,
  elevated,
  interactive,
  eyebrow,
  title,
  titleHtml,
  titleLevel,
  titleSize,
  body,
  bodyHtml,
  href,
  class: classProp,
  className,
  ...rest
} = Astro.props;

const classes = [
  cardClassNames({
    surface,
    featured,
    current,
    layout,
    elevated,
    interactive: interactive || Boolean(href),
    titleSize,
  }),
  classProp,
  className,
]
  .filter(Boolean)
  .join(' ');

const level: CardTitleLevel = titleLevel === 3 ? 3 : 2;
const HeadingTag = level === 3 ? 'h3' : 'h2';
const hasHeaderSlot = Astro.slots.has('header');
const hasHeaderActionsSlot = Astro.slots.has('headerActions');
const hasActionsSlot = Astro.slots.has('actions');
const hasFooterSlot = Astro.slots.has('footer');
const hasDefaultSlot = Astro.slots.has('default');
const hasHeading = Boolean(titleHtml) || Boolean(title);
const hasHeader = hasHeaderSlot || Boolean(eyebrow) || hasHeading || hasHeaderActionsSlot;
const hasMain = hasHeader || Boolean(bodyHtml) || Boolean(body) || hasDefaultSlot;
const isSplit = layout === 'split';
const isBlockHtml = bodyHtml
  ? /^\s*<(?:p|ul|ol|div|dl|blockquote|table|figure|section|h[1-6])\b/i.test(bodyHtml)
  : false;
const headerClass = hasHeaderActionsSlot || eyebrow ? 'eevenkoto-card__header' : undefined;
const headerActionsClass = cardHeaderActionsClassNames();
const headerGroupClass = cardHeaderGroupClassNames();
const eyebrowClass = cardEyebrowClassNames();
---
<article class={classes} {...rest}>
  {href ? (
    <a href={href}>
      {isSplit ? (
        <>
          {hasMain ? (
            <div class="eevenkoto-card__body">
              {hasHeader ? (
                <header class={headerClass}>
                  {hasHeaderSlot ? (
                    <slot name="header" />
                  ) : eyebrow && hasHeading ? (
                    <div class={headerGroupClass}>
                      <p class={eyebrowClass}>{eyebrow}</p>
                      {titleHtml ? <HeadingTag set:html={titleHtml} /> : <HeadingTag>{title}</HeadingTag>}
                    </div>
                  ) : (
                    <>
                      {eyebrow ? <p class={eyebrowClass}>{eyebrow}</p> : null}
                      {titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
                    </>
                  )}
                  {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
                </header>
              ) : null}
              {bodyHtml ? (
                isBlockHtml ? (
                  <div class="eevenkoto-card__body" set:html={bodyHtml} />
                ) : (
                  <p set:html={bodyHtml} />
                )
              ) : body ? (
                <p>{body}</p>
              ) : null}
              <slot />
            </div>
          ) : null}
          {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
          {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
        </>
      ) : (
        <>
          {hasHeader ? (
            <header class={headerClass}>
              {hasHeaderSlot ? (
                <slot name="header" />
              ) : eyebrow && hasHeading ? (
                <div class={headerGroupClass}>
                  <p class={eyebrowClass}>{eyebrow}</p>
                  {titleHtml ? <HeadingTag set:html={titleHtml} /> : <HeadingTag>{title}</HeadingTag>}
                </div>
              ) : (
                <>
                  {eyebrow ? <p class={eyebrowClass}>{eyebrow}</p> : null}
                  {titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
                </>
              )}
              {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
            </header>
          ) : null}
          {bodyHtml ? (
            isBlockHtml ? (
              <div class="eevenkoto-card__body" set:html={bodyHtml} />
            ) : (
              <p set:html={bodyHtml} />
            )
          ) : body ? (
            <p>{body}</p>
          ) : null}
          <slot />
          {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
          {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
        </>
      )}
    </a>
  ) : isSplit ? (
    <>
      {hasMain ? (
        <div class="eevenkoto-card__body">
          {hasHeader ? (
            <header class={headerClass}>
              {hasHeaderSlot ? (
                <slot name="header" />
              ) : eyebrow && hasHeading ? (
                <div class={headerGroupClass}>
                  <p class={eyebrowClass}>{eyebrow}</p>
                  {titleHtml ? <HeadingTag set:html={titleHtml} /> : <HeadingTag>{title}</HeadingTag>}
                </div>
              ) : (
                <>
                  {eyebrow ? <p class={eyebrowClass}>{eyebrow}</p> : null}
                  {titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
                </>
              )}
              {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
            </header>
          ) : null}
          {bodyHtml ? (
            isBlockHtml ? (
              <div class="eevenkoto-card__body" set:html={bodyHtml} />
            ) : (
              <p set:html={bodyHtml} />
            )
          ) : body ? (
            <p>{body}</p>
          ) : null}
          <slot />
        </div>
      ) : null}
      {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
      {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
    </>
  ) : (
    <>
      {hasHeader ? (
        <header class={headerClass}>
          {hasHeaderSlot ? (
            <slot name="header" />
          ) : eyebrow && hasHeading ? (
            <div class={headerGroupClass}>
              <p class={eyebrowClass}>{eyebrow}</p>
              {titleHtml ? <HeadingTag set:html={titleHtml} /> : <HeadingTag>{title}</HeadingTag>}
            </div>
          ) : (
            <>
              {eyebrow ? <p class={eyebrowClass}>{eyebrow}</p> : null}
              {titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
            </>
          )}
          {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
        </header>
      ) : null}
      {bodyHtml ? (
        isBlockHtml ? (
          <div class="eevenkoto-card__body" set:html={bodyHtml} />
        ) : (
          <p set:html={bodyHtml} />
        )
      ) : body ? (
        <p>{body}</p>
      ) : null}
      <slot />
      {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
      {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
    </>
  )}
</article>
