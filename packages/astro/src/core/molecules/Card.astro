---
import {
  cardClassNames,
  cardHeaderActionsClassNames,
  type CardProps,
  type CardTitleLevel,
} from '@eevenkoto/core';

export interface Props extends CardProps {
  href?: string;
  class?: string;
  className?: string;
  [key: string]: unknown;
}

const {
  surface,
  accent,
  current,
  layout,
  elevated,
  interactive,
  title,
  titleHtml,
  titleLevel,
  body,
  bodyHtml,
  href,
  class: classProp,
  className,
  ...rest
} = Astro.props;

const classes = [
  cardClassNames({
    surface,
    accent,
    current,
    layout,
    elevated,
    interactive: interactive || Boolean(href),
  }),
  classProp,
  className,
]
  .filter(Boolean)
  .join(' ');

const level: CardTitleLevel = titleLevel === 3 ? 3 : 2;
const HeadingTag = level === 3 ? 'h3' : 'h2';
const hasHeaderSlot = Astro.slots.has('header');
const hasHeaderActionsSlot = Astro.slots.has('headerActions');
const hasActionsSlot = Astro.slots.has('actions');
const hasFooterSlot = Astro.slots.has('footer');
const hasDefaultSlot = Astro.slots.has('default');
const hasHeader = hasHeaderSlot || Boolean(titleHtml) || Boolean(title) || hasHeaderActionsSlot;
const hasMain = hasHeader || Boolean(bodyHtml) || Boolean(body) || hasDefaultSlot;
const isSplit = layout === 'split';
const isBlockHtml = bodyHtml
  ? /^\s*<(?:p|ul|ol|div|dl|blockquote|table|figure|section|h[1-6])\b/i.test(bodyHtml)
  : false;
const headerClass = hasHeaderActionsSlot ? 'eevenkoto-card__header' : undefined;
const headerActionsClass = cardHeaderActionsClassNames();
---
<article class={classes} {...rest}>
  {href ? (
    <a href={href}>
      {isSplit ? (
        <>
          {hasMain ? (
            <div class="eevenkoto-card__body">
              {hasHeader ? (
                <header class={headerClass}>
                  {hasHeaderSlot ? <slot name="header" /> : titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
                  {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
                </header>
              ) : null}
              {bodyHtml ? (
                isBlockHtml ? (
                  <div class="eevenkoto-card__body" set:html={bodyHtml} />
                ) : (
                  <p set:html={bodyHtml} />
                )
              ) : body ? (
                <p>{body}</p>
              ) : null}
              <slot />
            </div>
          ) : null}
          {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
          {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
        </>
      ) : (
        <>
          {hasHeader ? (
            <header class={headerClass}>
              {hasHeaderSlot ? <slot name="header" /> : titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
              {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
            </header>
          ) : null}
          {bodyHtml ? (
            isBlockHtml ? (
              <div class="eevenkoto-card__body" set:html={bodyHtml} />
            ) : (
              <p set:html={bodyHtml} />
            )
          ) : body ? (
            <p>{body}</p>
          ) : null}
          <slot />
          {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
          {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
        </>
      )}
    </a>
  ) : isSplit ? (
    <>
      {hasMain ? (
        <div class="eevenkoto-card__body">
          {hasHeader ? (
            <header class={headerClass}>
              {hasHeaderSlot ? <slot name="header" /> : titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
              {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
            </header>
          ) : null}
          {bodyHtml ? (
            isBlockHtml ? (
              <div class="eevenkoto-card__body" set:html={bodyHtml} />
            ) : (
              <p set:html={bodyHtml} />
            )
          ) : body ? (
            <p>{body}</p>
          ) : null}
          <slot />
        </div>
      ) : null}
      {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
      {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
    </>
  ) : (
    <>
      {hasHeader ? (
        <header class={headerClass}>
          {hasHeaderSlot ? <slot name="header" /> : titleHtml ? <HeadingTag set:html={titleHtml} /> : title ? <HeadingTag>{title}</HeadingTag> : null}
          {hasHeaderActionsSlot ? <div class={headerActionsClass}><slot name="headerActions" /></div> : null}
        </header>
      ) : null}
      {bodyHtml ? (
        isBlockHtml ? (
          <div class="eevenkoto-card__body" set:html={bodyHtml} />
        ) : (
          <p set:html={bodyHtml} />
        )
      ) : body ? (
        <p>{body}</p>
      ) : null}
      <slot />
      {hasActionsSlot ? <div class="eevenkoto-card__actions"><slot name="actions" /></div> : null}
      {hasFooterSlot ? <footer><slot name="footer" /></footer> : null}
    </>
  )}
</article>
