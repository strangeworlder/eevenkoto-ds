{
  "name": "@eevenkoto/react",
  "version": "0.1.1",
  "description": "Eevenkoto React component wrappers",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external @eevenkoto/core",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react --external @eevenkoto/core"
  },
  "dependencies": {
    "@eevenkoto/core": "0.1.1"
  },
  "peerDependencies": {
    "@eevenkoto/css": "0.1.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@eevenkoto/css": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
